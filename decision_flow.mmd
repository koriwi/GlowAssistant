flowchart TD
    Input["User request"] --> Snapshot["Read exposed entities, states and available actions"]
    Snapshot --> Service{"Decider: service / route"}

    Service -->|unsure| Unsure["Unsure reply"]
    Service -->|general| Enabled{"General model enabled?"}
    Enabled -->|No| Unsure
    Enabled -->|Yes| General["General model + optional HTTP MCP tools"]
    General --> Reply["Assistant reply"]

    Service -->|query_state| QueryArea{"Decider: area"}
    QueryArea -->|Specific room| Room["Filter entities by room"]
    QueryArea -->|"all_areas: no room specified or whole home"| Domains["Decider: choose one domain"]
    Room --> Domains
    Domains --> DomainEntities["Filter entities by selected domain"]
    DomainEntities --> QueryType{"Decider: yes/no question?"}
    QueryType -->|Yes| BinaryAnswer["Decider: yes / no / unsure from candidate states"]
    BinaryAnswer -->|unsure| Unsure
    BinaryAnswer -->|yes / no| Translate["Answer model: translate yes/no into Assist language"]
    Translate --> Reply
    QueryType -->|No| QueryTargets["Decider: entity keep/drop"]
    QueryType -->|unsure| Unsure
    QueryTargets --> States["Read selected states from snapshot"]
    States --> Answer["Smart-home answer model"]
    Answer --> Reply

    Service -->|HA action| Scope{"Decider: intended target type"}
    Scope -->|Arealess entities| DomainOnly["Filter entities by action domain"]
    Scope -->|"Entities + explicit area"| OneArea["Decider: choose the one highest-probability area"]
    OneArea --> DomainArea["Filter entities by action domain and selected area"]
    Scope -->|"Entities + implied area"| Speaker["Use speaker area from HA context"]
    Speaker --> DomainArea
    DomainOnly --> Entities["Decider: one Choice; keep entities above probability threshold"]
    DomainArea --> Entities
    Scope -->|"Explicit area(s), no specific entities"| Areas["Decider: one Choice; keep areas above probability threshold"]
    Scope -->|"Implied area only"| SpeakerOnly["Use speaker area directly; no area or entity model call"]
    Areas --> AreaTargets["Selected areas are the targets"]
    SpeakerOnly --> AreaTargets
    Scope -->|unsure| Unsure
    Entities --> Capabilities["Expand resolved targets; keep fields supported by every entity"]
    AreaTargets --> Capabilities
    Capabilities --> Required["List applicable required action fields"]
    Required --> HasOptional{"Optional fields available?"}
    HasOptional -->|Yes| Parameters["Decider: optional parameters + none; keep above probability threshold"]
    HasOptional -->|No| Console["Print targets, required/optional fields and timing"]
    Parameters --> Console
    Console --> Stop["Stop: no value extraction or device actions"]
