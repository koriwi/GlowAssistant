flowchart TD
    Input["User request"] --> Snapshot["Read exposed entities, states and available actions"]
    Snapshot --> Service{"Decider: service / route"}

    Service -->|unsure| Unsure["Unsure reply"]
    Service -->|general| Enabled{"General model enabled?"}
    Enabled -->|No| Unsure
    Enabled -->|Yes| General["General model + optional HTTP MCP tools"]
    General --> Reply["Assistant reply"]

    Service -->|query_state| QueryArea{"Decider: area"}
    QueryArea -->|Specific room| Room["Filter entities by room"]
    QueryArea -->|"all_areas: no room specified or whole home"| Domains["Decider: choose one domain"]
    Room --> Domains
    Domains --> DomainEntities["Filter entities by selected domain"]
    DomainEntities --> QueryType{"Decider: yes/no question?"}
    QueryType -->|Yes| BinaryAnswer["Decider: yes / no / unsure from candidate states"]
    BinaryAnswer -->|unsure| Unsure
    BinaryAnswer -->|yes / no| BinaryMode{"LLM answer enabled?"}
    BinaryMode -->|Yes| Translate["Answer model: translate yes/no into Assist language"]
    BinaryMode -->|No| FixedBinary["Fixed Ja/Nein or Yes/No reply"]
    Translate --> Reply
    FixedBinary --> Reply
    QueryType -->|No| QueryTargets["Decider: one Choice over entities + none; retain at or above relative probability cutoff"]
    QueryType -->|unsure| Unsure
    QueryTargets --> States["Read selected states from snapshot"]
    States --> QueryReplyMode{"LLM answer enabled?"}
    QueryReplyMode -->|Yes| Answer["Smart-home answer model"]
    QueryReplyMode -->|No| Property["Decider: choose one requested state property"]
    Property -->|unsure| Unsure
    Property -->|Selected| StateText["Format entity names + values + units"]
    StateText --> Reply
    Answer --> Reply

    Service -->|HA action| Scope{"Decider: intended target type"}
    Scope -->|Arealess entities| DomainOnly["Filter entities by action domain"]
    Scope -->|"Entities + explicit area"| OneArea["Decider: unique highest-probability area; confidence at least configured minimum"]
    OneArea -->|None, tie or low confidence| Unsure
    OneArea --> DomainArea["Filter entities by action domain and selected area"]
    Scope -->|"Entities + implied area"| Speaker["Use speaker area from HA context"]
    Speaker --> DomainArea
    DomainOnly --> Entities["Decider: one Choice; keep entities at or above relative probability cutoff"]
    DomainArea --> Entities
    Scope -->|"Explicit area(s), no specific entities"| Areas["Decider: one Choice; keep areas at or above relative probability cutoff"]
    Scope -->|"Implied area only"| SpeakerOnly["Use speaker area directly; no area or entity model call"]
    Areas --> AreaTargets["Selected areas are the targets"]
    SpeakerOnly --> AreaTargets
    Scope -->|unsure| Unsure
    Entities --> Capabilities["Expand resolved targets; keep fields supported by any entity; track support per field"]
    AreaTargets --> Capabilities
    Capabilities --> Required["List applicable required action fields"]
    Required --> HasOptional{"Optional fields available?"}
    HasOptional -->|Yes| Parameters["Decider: optional parameters + none; keep at or above relative probability cutoff"]
    HasOptional -->|No| ValueFields["Required + retained optional fields"]
    Parameters --> ValueFields
    ValueFields --> Types{"Preflight every HA selector"}
    Types -->|Unsupported format or range| Unsupported["Error: not yet supported"]
    Types -->|All supported| Each["For each selected field"]
    Each -->|Text| Text["Choice over word occurrences + none; p at or above relative cutoff"]
    Each -->|Number| Numeric["Absolute/relative Choice + Score; HA range, step and current settings"]
    Each -->|Select| SelectValue["One Choice over fixed HA values + none; single value or relative-cutoff list"]
    Text -->|Empty or invalid| Unsure
    Numeric -->|Unclear or missing relative baseline| Unsure
    Text -->|Words retained| Values["Store value for this field"]
    Numeric -->|Valid number| Values
    SelectValue -->|No matching values| Unsure
    SelectValue -->|Valid string or list| Values
    Values -->|More fields| Each
    Values -->|All complete| Console["Print targets, parameter values and per-field timings"]
    Console --> Plan["Build explicit entity calls; group by supported parameters"]
    Plan --> DryRun{"dry_run?"}
    DryRun -->|Yes| Planned["Record planned calls; never invoke executor"]
    DryRun -->|No| Execute["Recheck exposure/exclusions; call HA sequentially; no retries"]
    Execute -->|Failure or partial| ExecutionError["Error reply; preserve completed/unconfirmed outcomes"]
    Execute -->|Completed| ResponseData["Collect action response data when supported; preserve in debug/logs"]
    ResponseData --> ActionReplyMode{"LLM answer enabled?"}
    Planned --> ActionReplyMode
    ActionReplyMode -->|Yes| PlanAnswer["Answer model: describe actual execution outcome or dry-run plan"]
    ActionReplyMode -->|No| HasResponse{"Action returns data?"}
    HasResponse -->|Yes| DataReply["Format returned list items or JSON; dry-run has no result data"]
    HasResponse -->|No| Ack["ok"]
    DataReply --> Reply
    PlanAnswer --> Reply
    Ack --> Reply

    Reply --> LogToggle{"Run logging enabled?"}
    ExecutionError --> LogToggle
    Unsupported --> LogToggle
    Unsure --> LogToggle
    LogToggle -->|No| Finish["Return reply"]
    LogToggle -->|Yes| Log["Write redacted JSON: successful / unsuccessful; no device retries on log failure"]
    Log --> Finish
